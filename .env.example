.env example for local development (do NOT commit real secrets)

# Supabase - used by edge functions
PROJECT_URL=https://your-project.supabase.co
SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: an application JWT secret if you plan to mint your own session tokens
AUTH_JWT_SECRET=replace-with-a-very-strong-secret

# Frontend: URL where Supabase functions are hosted (optional)
VITE_FUNCTIONS_URL=https://your-project.functions.supabase.co

# Frontend: public Supabase client config for direct RLS-protected table reads
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Balance Base SimpleFIN sync secret:
#   supabase secrets set SIMPLEFIN_ACCESS_URL="your_access_url_here"
#
# First claim/exchange the SimpleFIN setup token for an Access URL.
# Save only the Access URL as the Supabase secret.
# Do not put SIMPLEFIN_ACCESS_URL in .env for Vite.
# Do not use VITE_SIMPLEFIN_ACCESS_URL.
# The browser must never receive the SimpleFIN setup token or access URL.
